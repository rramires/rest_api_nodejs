{
	"name": "rest_api_nodejs",
	"version": "1.0.0",
	"description": "Rest API - NodeJs, using Fastify, TypeScript, KnexJs, Vitest, etc",
	"main": "src/server.js",
	"type": "module",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "tsx watch src/server.ts",
		"compile": "npx tsc",
		"knex": "node --import tsx ./node_modules/knex/bin/cli.js",
		"test": "vitest",
		"build": "tsup src --format esm --out-dir build"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/rramires/rest_api_nodejs.git"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"bugs": {
		"url": "https://github.com/rramires/rest_api_nodejs/issues"
	},
	"homepage": "https://github.com/rramires/rest_api_nodejs#readme",
	"dependencies": {
		"@fastify/cookie": "^11.0.2",
		"better-sqlite3": "^11.9.1",
		"dotenv": "^16.5.0",
		"fastify": "^5.2.2",
		"knex": "^3.1.0",
		"pg": "^8.15.6",
		"zod": "^3.24.2",
		"tsup": "^8.4.0",
		"tsx": "^4.19.3",
		"typescript": "^5.8.3"
	},
	"devDependencies": {
		"@types/better-sqlite3": "^7.6.13",
		"@types/node": "^22.14.0",
		"@types/pg": "^8.11.14",
		"@types/supertest": "^6.0.3",
		"supertest": "^7.1.0",
		"vitest": "^3.1.1"
	}
}